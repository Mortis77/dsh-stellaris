    "python": ">=3.10"
  },
  "author": "Sengoku Yuno",
  "repository": {
    "type": "git",
    "url": "https://github.com/<USER>/dsh-stellaris.git"
  },
  "bugs": {
    "url": "https://github.com/<USER>/dsh-stellaris/issues"
  }
}
